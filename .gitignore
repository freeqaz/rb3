# Cache directories
.idea/
.vs/
__pycache__/

# Ninja
build/
.ninja_deps
.ninja_log
.ninja_lock
.ninja-build.lock
build.ninja
objdiff.json

# Native port CMake build dirs
native/build*/

# Convenience symlink into orig-assets/extracted/
/system

# clangd
.cache/
compile_commands.json

# Doxygen output
doxygen/

# Excluded tools
tools/mwcc_compiler/*

# Local convenience symlink into ../dc3-decomp/tools/compiler_trace
tools/compiler_trace

# Generated context files
ctx.c
ctx.cpp
ctx.h
ctx.hpp

# Original game files
orig/*
!orig/SZBE69.sha1

# Game ROM dumps (never check these in)
*.wbfs
*.iso
*.wad
*.nkit.iso

# Extracted asset tree (~4 GB; produced by scripts/milo/extract_ark.sh)
# Ignore the *contents* (not the dir itself) so child negations can re-include
# subdirs — `orig-assets/` would block descent into native-refs/ subfolders.
orig-assets/*
# Exception: checked-in native reference renders + UI ground-truth screenshots.
!orig-assets/native-refs/
!orig-assets/native-refs/**

# Used to persist certain empty folders
# Search patterns covering folders that need to be persisted must end with an asterisk,
# or else this file will always be ignored
!*.gitkeep

# To-be-RE'd source files generated from splits.txt
src_todo/

# General-purpose ignore
ignore/
ignored/
*.ignore.*
*.ignored.*

# Analysis databases
cache.db
decomp.db
decomp.db-shm
decomp.db-wal
decomp.db.*-backup
permuter_cache.db
permuter_cache.db-shm
permuter_cache.db-wal
.objdiff_report_cache

# Analysis output files (large, per-function dumps)
DeformMesh__*
LeaveState__*
SwapResource__*
AddBoneInternal__*
DrawShowing__*
PollFrontLoader__*
ReadCounts__*
MD5Transform
OSSuspendThread
__ct__*
function_analysis/

# Source permuter scratch / work files
.permuter_work_*
.permuter_pp_*
*.permuter.lock
*.permuter_bak

# Stray build/analysis artifacts (dep files, backups, compiled output)
*.d
*.bak
*.bak[0-9]
a.out

# Ghidra project files
ghidra_projects/

# objdiff binary
bin/objdiff-cli

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# rust target folders
tools/*/target/
.DS_Store

# Native-port screenshot dumps (PNGs only; REVIEW.md / POLISH_REPORT.md stay tracked)
/screenshots/
docs/sessions/**/screenshots/**/*.png
docs/sessions/**/screenshots/**/*.jpg
docs/sessions/**/screenshots/**/*.jpeg

# Permuter auto-sweep run logs (one dir per fleet run, large attempt dumps)
logs/permuter/auto_*/
