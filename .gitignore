# Cache directories
.idea/
.vs/
__pycache__/

# Ninja
build/
.ninja_deps
.ninja_log
.ninja_lock
.ninja-build.lock
build.ninja
objdiff.json

# Native port CMake build dirs
native/build*/

# Convenience symlink into orig-assets/extracted/
/system

# clangd
.cache/
compile_commands.json

# Session-telemetry SQLite store (runtime state, regenerated by server.py ingest)
native/web/telemetry/*.db
native/web/telemetry/*.db-wal
native/web/telemetry/*.db-shm
native/web/telemetry/raw/

# Doxygen output
doxygen/

# Excluded tools
tools/mwcc_compiler/*

# Local convenience symlink into ../dc3-decomp/tools/compiler_trace
tools/compiler_trace

# Generated context files
ctx.c
ctx.cpp
ctx.h
ctx.hpp

# Original game files
orig/*
!orig/SZBE69.sha1

# Game ROM dumps (never check these in)
*.wbfs
*.iso
*.wad
*.nkit.iso

# Extracted asset tree (~4 GB; produced by scripts/milo/extract_ark.sh)
orig-assets/
# Exception: checked-in native reference renders for pixelmatch regression guard.
!orig-assets/native-refs/
!orig-assets/native-refs/**
# A4 web texture downscale: generated mip-stripped venue milos (build/deploy
# output, like the brotli encode cache — NOT the canonical extracted tree).
# Already covered by orig-assets/ above; listed explicitly so it's never committed
# even if that rule gains more exceptions. Regenerate: scripts/web/gen_web_downscaled.py
orig-assets/web-downscaled/

# Used to persist certain empty folders
# Search patterns covering folders that need to be persisted must end with an asterisk,
# or else this file will always be ignored
!*.gitkeep

# To-be-RE'd source files generated from splits.txt
src_todo/

# General-purpose ignore
ignore/
ignored/
*.ignore.*
*.ignored.*

# Repo-local scratch (throwaway captures, temp audio, etc.)
tmp/

# audio-perf-loop baseline measurement dumps (per-run capture JSON; the .md
# writeups + STATE.md stay tracked). These are reproducible measurement
# artifacts, not source.
docs/native/audio-perf-loop/baselines/*.json

# Analysis databases
cache.db
decomp.db
decomp.db-shm
decomp.db-wal
decomp.db.*-backup
permuter_cache.db
permuter_cache.db-shm
permuter_cache.db-wal
.objdiff_report_cache

# Analysis output files (large, per-function dumps)
DeformMesh__*
LeaveState__*
SwapResource__*
AddBoneInternal__*
DrawShowing__*
PollFrontLoader__*
ReadCounts__*
DropUser__*
Execute__9*
Handle__13*
MD5Transform
OSSuspendThread
__ct__*
function_analysis/

# Source permuter scratch / work files
.permuter_work_*
.permuter_pp_*
*.permuter.lock
*.permuter_bak

# Stray build/analysis artifacts (dep files, backups, compiled output)
*.d
*.bak
*.bak[0-9]
a.out

# Ghidra project files
ghidra_projects/

# objdiff binary
bin/objdiff-cli

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/workflows/

# rust target folders
tools/*/target/
.DS_Store

# Native-port screenshot dumps (PNGs + generated capture-summary.json;
# REVIEW.md / POLISH_REPORT.md and other hand-written .md stay tracked)
/screenshots/
docs/sessions/**/screenshots/**/*.png
docs/sessions/**/screenshots/**/*.jpg
docs/sessions/**/screenshots/**/*.jpeg
docs/sessions/**/screenshots/**/*.json

# Permuter auto-sweep run logs (one dir per fleet run, large attempt dumps)
logs/permuter/auto_*/

# Xenon-hardening research/forensics artifacts (local-only generated dumps:
# sysnet Wii asm/m2c, per-pair evidence/judgments, plans — not repo material)
docs/decomp/xenon-hardening/round2/forensics/*sysnet*
docs/decomp/xenon-hardening/round3/evidence-systemnetwork.md
docs/decomp/xenon-hardening/round3/evidence/pair-*.md
docs/decomp/xenon-hardening/round3/judgments/
docs/decomp/xenon-hardening/round3/round3-plans.json

# Engine-arch-review wave evidence dumps (large per-wave PNG/log/gz/txt/json
# capture artifacts kept on disk locally; the hand-written wave docs — STATUS.md,
# PLAN.md, SWEEP.md, README.md outside evidence/ — stay tracked). Stripped from
# history 2026-07-10 to keep the push small; force-add individual files if a
# specific capture is worth publishing (git add -f <path>).
docs/native/engine-arch-review-2026-07-05/execution/**/evidence/
