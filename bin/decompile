#!/usr/bin/env python3
"""
Decompile a function from the RB3 original binary using m2c.

Usage:
  bin/decompile RecordTrillStats__9GemPlayerFv
  bin/decompile -u game/GemPlayer RecordTrillStats__9GemPlayerFv
  bin/decompile -u game/GemPlayer RecordTrillStats__9GemPlayerFv -c src/band3/game/GemPlayer.cpp
"""

import argparse
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).parent.parent
M2C = ROOT.parent / "m2c" / "m2c.py"
ASM_DIR = ROOT / "build/SZBE69_B8/asm"
SRC_DIR = ROOT / "src"


def find_context_file(asm_file: Path) -> Path | None:
    """Try to find the C++ source file corresponding to an asm file."""
    # asm path is like build/SZBE69_B8/asm/band3/game/GemPlayer.s
    # source is like src/band3/game/GemPlayer.cpp
    rel = asm_file.relative_to(ASM_DIR).with_suffix("")
    for ext in (".cpp", ".c"):
        candidate = SRC_DIR / (str(rel) + ext)
        if candidate.exists():
            return candidate
    return None


def guess_class_name(function: str) -> str | None:
    """Extract class name from a mangled symbol like Bar__6MyObjFv -> MyObj."""
    import re
    m = re.search(r'__(\d+)(\w+)', function)
    if m:
        length = int(m.group(1))
        name = m.group(2)[:length]
        if len(name) == length:
            return name
    return None


def find_asm_file(function: str, unit: str | None) -> Path:
    if unit:
        # Normalize: strip leading 'main/' prefix from db-style unit names
        unit = unit.removeprefix("main/")
        candidate = ASM_DIR / (unit + ".s")
        if candidate.exists():
            return candidate
        # Try stripping a source-subdir prefix that may have been omitted
        for prefix in ("band3/", "system/", "network/", "lib/", "sdk/"):
            candidate = ASM_DIR / prefix / (unit + ".s")
            if candidate.exists():
                return candidate
        print(f"error: asm file not found for unit '{unit}'", file=sys.stderr)
        print(f"  tried: {ASM_DIR / (unit + '.s')}", file=sys.stderr)
        sys.exit(1)

    # Try to narrow search using class name from mangled symbol
    class_name = guess_class_name(function)
    if class_name:
        for candidate in sorted(ASM_DIR.rglob(f"{class_name}.s")):
            needle = f".fn {function},"
            for line in candidate.open():
                if needle in line:
                    return candidate

    # Search all asm files for the function using grep for speed
    needle = f".fn {function},"
    try:
        result = subprocess.run(
            ["grep", "-rl", "--include=*.s", needle, str(ASM_DIR)],
            capture_output=True, text=True,
        )
        if result.returncode == 0 and result.stdout.strip():
            return Path(result.stdout.strip().splitlines()[0])
    except FileNotFoundError:
        pass
    # Fallback: Python search
    for asm_file in sorted(ASM_DIR.rglob("*.s")):
        for line in asm_file.open():
            if needle in line:
                return asm_file

    print(f"error: function '{function}' not found in any asm file", file=sys.stderr)
    sys.exit(1)


def main():
    parser = argparse.ArgumentParser(
        description="Decompile a function from the RB3 binary using m2c."
    )
    parser.add_argument("function", help="Mangled function name (e.g. RecordTrillStats__9GemPlayerFv)")
    parser.add_argument("-u", "--unit", help="Unit path (e.g. game/GemPlayer or main/band3/game/GemPlayer)")
    parser.add_argument("-c", "--context", help="C/C++ context file for type info")
    parser.add_argument("--passes", type=int, default=4, help="m2c translation passes (default: 4)")
    args = parser.parse_args()

    if not M2C.exists():
        print(f"error: m2c not found at {M2C}", file=sys.stderr)
        sys.exit(1)

    asm_file = find_asm_file(args.function, args.unit)
    print(f"# asm: {asm_file.relative_to(ROOT)}", file=sys.stderr)

    cmd = [
        sys.executable, str(M2C),
        "--target", "ppc",
        "-f", args.function,
        "--passes", str(args.passes),
    ]
    context = args.context
    if not context:
        ctx = find_context_file(asm_file)
        if ctx:
            context = str(ctx)
            print(f"# context: {ctx.relative_to(ROOT)}", file=sys.stderr)
    if context:
        cmd += ["--context", context]
    cmd.append(str(asm_file))

    result = subprocess.run(cmd)
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
