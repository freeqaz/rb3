+	/**
+	 * One unit of Phase B aggregation work: populate a single FunctionNode's associates
+	 * map from its complete, pre-grouped pair list.
+	 */
+	private static class NodeAssociateWork {
+		private final FunctionNode node;
+		private final ArrayList<FunctionPair> pairs;
+		private final boolean nodeIsSource;	// true if -node- is the source side of its pairs
+
+		NodeAssociateWork(FunctionNode node, ArrayList<FunctionPair> pairs,
+				boolean nodeIsSource) {
+			this.node = node;
+			this.pairs = pairs;
+			this.nodeIsSource = nodeIsSource;
+		}
+
+		void apply() {
+			node.presizeAssociates(pairs.size());
+			for (FunctionPair pair : pairs) {
+				FunctionNode other = nodeIsSource ? pair.getDestNode() : pair.getSourceNode();
+				node.addAssociate(other, pair);
+			}
+		}
+	}
+
+	/**
+	 * Parallel callback for Phase B: each work item touches exactly one node, so the
+	 * plain HashMap inside FunctionNode is safe without synchronization.
+	 */
+	private static class AggregationCallback implements QCallback<NodeAssociateWork, Object> {
+		@Override
+		public Object process(NodeAssociateWork item, TaskMonitor monitor) throws Exception {
+			monitor.checkCancelled();
+			item.apply();
+			monitor.incrementProgress(1);
+			return null;
+		}
