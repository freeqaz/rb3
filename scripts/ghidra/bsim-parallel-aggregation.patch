 	/**
+	 * Replace the (still empty) associates map with one pre-sized for an exact,
+	 * already-known number of entries.  This eliminates the incremental
+	 * rehash/doubling cost of populating a default-sized HashMap one put at a time,
+	 * which dominates the correlator's result-aggregation phase when a node has
+	 * thousands of potential matches.
+	 *
+	 * Package-private by design: only the aggregation phase of
+	 * {@link BSimProgramCorrelatorMatching#discoverPotentialMatches} may call this,
+	 * and only BEFORE any associate has been added (the map is replaced, not copied).
+	 * @param expectedCount the exact number of associates about to be added
+	 */
+	void presizeAssociates(int expectedCount) {
+		// Smallest capacity that holds expectedCount entries without a resize at the
+		// default 0.75 load factor (HashMap rounds up to a power of two internally).
+		int capacity = (int) (expectedCount / 0.75f) + 1;
+		associates = new HashMap<FunctionNode, FunctionPair>(capacity);
+	}
