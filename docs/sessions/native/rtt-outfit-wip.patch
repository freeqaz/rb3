+// the main pass preserving everything drawn (LoadOp::Load). For a between-frame
+// bake, finish + submit the transient encoder immediately (the baked texture is
+// then a valid sampled view for subsequent body draws).
+void BandRnd::RB3FinishRenderTarget(RndTex* tex) {
+    if (!mGpuReady || mActiveTargetTex != tex) return;
+    EndActivePass();
+    mActiveTargetTex = nullptr;
+    // Latch the target as composited so GetRB3TexView now binds its rendered view.
+    auto it = sTexGpu.find(tex);
+    if (it != sTexGpu.end()) it->second.composited = true;
+    if (mRtTransientEncoder) {
+        if (mRtEncoder) {
+            wgpu::CommandBuffer cmd = mRtEncoder.Finish();
+            mGpu.Queue().Submit(1, &cmd);
+            mRtEncoder = nullptr;
+        }
+        mRtTransientEncoder = false;
+    } else if (mFrameView) {
+        BeginMainPass(false);
+    }
+}
