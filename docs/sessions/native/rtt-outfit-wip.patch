+    wgpu::TexelCopyBufferLayout layout{}; layout.bytesPerRow = w * 4;
+    wgpu::Extent3D ext = {w, h, 1};
+    gpu.Queue().WriteTexture(&dstInfo, black.data(), black.size(), &layout, &ext);
+
+    e.tex = t;
+    e.view = t.CreateView();
+    e.renderTarget = true;
+    e.rtW = w; e.rtH = h;
+    e.uploaded = true;        // a render target is "ready" once created
+    e.lastPixels = nullptr;   // not driven by mBitmap CPU churn
+    e.fingerprint = 0;
+    return &e;
