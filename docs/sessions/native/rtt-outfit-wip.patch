+// RTT Layer C: BandRnd::DrawRect — the tint/layer painter.
+//
+// Self-contained screen-space textured-quad blit (the plan's "C2"), NOT the DC3
+// gfx/DrawRect2D helper (which hard-refs DC3-only globals — TheRnd as WgpuRnd&,
+// gWgpuRnd, GetGpuTexView, CurrentTargetFormat — that are OFF for the rb3
+// backend). Builds its own shader/pipeline/vertex buffer, mirroring the DC3
+// DrawRect2D pattern but inline. Paints OutfitConfig's base-color + two-color
+// tint layers into the active render-target pass.
+// ===========================================================================
+static const char* kRB3RectShaderSrc = R"WGSL(
+struct V2D { @location(0) pos: vec2f, @location(1) uv: vec2f, @location(2) color: vec4f, };
+struct VSOut { @builtin(position) pos: vec4f, @location(0) uv: vec2f, @location(1) color: vec4f, };
+@vertex fn vs_rect(in: V2D) -> VSOut {
+    var o: VSOut; o.pos = vec4f(in.pos, 0.0, 1.0); o.uv = in.uv; o.color = in.color; return o;
+}
+@group(0) @binding(0) var rTex: texture_2d<f32>;
+@group(0) @binding(1) var rSmp: sampler;
+// kColorModNone (base fill): solid material color, no texture.
+@fragment fn fs_fill(in: VSOut) -> @location(0) vec4f { return in.color; }
+// kColorModModulate: texel * material color.
+@fragment fn fs_modulate(in: VSOut) -> @location(0) vec4f {
+    return textureSample(rTex, rSmp, in.uv) * in.color;
+}
+// kColorModAlphaUnpackModulate: texture alpha gates the material color
+// (mask layer — the texel's alpha is the per-texel blend weight).
+@fragment fn fs_mask(in: VSOut) -> @location(0) vec4f {
+    let t = textureSample(rTex, rSmp, in.uv);
+    return vec4f(in.color.rgb, in.color.a * t.a);
+}
+)WGSL";
