+// Open an off-screen render pass into a render-target RndTex's GPU texture
+// (Layer B). Color attachment = the target view, LoadOp::Clear (the first
+// DrawRect base-color fill seeds it; subsequent tint layers composite over it
+// via blend), NO depth attachment (kRenderedNoZ). The full-target viewport is
+// the WebGPU default for a pass (whole attachment), so no explicit SetViewport.
+// Uses mRtEncoder when baking between frames, else the shared per-frame mEncoder.
+void BandRnd::BeginTexturePass(RndTex* tex) {
+    RB3TexEntry* rt = RB3EnsureRenderTarget(mGpu, tex);
+    if (!rt || !rt->view) return;
+
+    wgpu::RenderPassColorAttachment colorAtt{};
+    colorAtt.view = rt->view;
+    colorAtt.loadOp = wgpu::LoadOp::Clear;
+    colorAtt.storeOp = wgpu::StoreOp::Store;
+    colorAtt.clearValue = {0.0, 0.0, 0.0, 0.0};
+
+    wgpu::RenderPassDescriptor rp{};
+    rp.label = "BandTexturePass";
+    rp.colorAttachmentCount = 1; rp.colorAttachments = &colorAtt;
+    rp.depthStencilAttachment = nullptr;
+
+    wgpu::CommandEncoder& enc = mRtTransientEncoder ? mRtEncoder : mEncoder;
+    mPass = enc.BeginRenderPass(&rp);
+    mInPass = true;
+    mActiveTargetTex = tex;
+    mActiveTargetW = rt->rtW; mActiveTargetH = rt->rtH;
+    if (getenv("RTT_DBG")) {
