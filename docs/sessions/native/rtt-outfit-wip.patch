+// RTT entry (from RndTex::MakeDrawTarget or the SyncRenderTargetState observer):
+// begin the off-screen composite pass into `tex`. If a main frame pass is live,
+// suspend it and reuse the per-frame encoder. If we're BETWEEN frames (the usual
+// case — OutfitConfig bakes outfit textures at character load/sync time, when the
+// per-frame encoder is already finished), spin up a dedicated transient encoder.
+void BandRnd::RB3SelectRenderTarget(RndTex* tex) {
+    if (!mGpuReady || !tex) return;
+    if (mInPass && mEncoder) {
+        // Mid-frame composite: suspend the live main/active pass, reuse mEncoder.
+        mRtTransientEncoder = false;
+        EndActivePass();
+    } else {
+        // Between-frame bake: no live frame — use a one-shot transient encoder.
+        mRtTransientEncoder = true;
+        mRtEncoder = mGpu.Device().CreateCommandEncoder();
+        mInPass = false;
+    }
+    BeginTexturePass(tex);
+}
+
+// RTT exit (from RndTex::FinishDrawTarget, fired by SetTargetTex(nullptr) /
