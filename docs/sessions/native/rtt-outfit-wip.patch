+struct RB3RectVert { float pos[2]; float uv[2]; float color[4]; };
+
+void BandRnd::EnsureRectPipeline() {
+    if (mRectReady) return;
+    auto& dev = mGpu.Device();
+
+    wgpu::ShaderSourceWGSL src;
+    src.code = kRB3RectShaderSrc;
+    wgpu::ShaderModuleDescriptor smd{};
+    smd.nextInChain = &src;
+    mRectShader = dev.CreateShaderModule(&smd);
+
+    wgpu::BindGroupLayoutEntry bgle[2] = {};
+    bgle[0].binding = 0; bgle[0].visibility = wgpu::ShaderStage::Fragment;
+    bgle[0].texture.sampleType = wgpu::TextureSampleType::Float;
+    bgle[0].texture.viewDimension = wgpu::TextureViewDimension::e2D;
+    bgle[1].binding = 1; bgle[1].visibility = wgpu::ShaderStage::Fragment;
+    bgle[1].sampler.type = wgpu::SamplerBindingType::Filtering;
+    wgpu::BindGroupLayoutDescriptor bgld{};
+    bgld.entryCount = 2; bgld.entries = bgle;
+    mRectBGL = dev.CreateBindGroupLayout(&bgld);
+
+    wgpu::PipelineLayoutDescriptor pld{};
+    pld.bindGroupLayoutCount = 1; pld.bindGroupLayouts = &mRectBGL;
+    mRectPL = dev.CreatePipelineLayout(&pld);
+
+    wgpu::BufferDescriptor vbd{};
+    vbd.size = 6 * sizeof(RB3RectVert);
+    vbd.usage = wgpu::BufferUsage::Vertex | wgpu::BufferUsage::CopyDst;
+    mRectVB = dev.CreateBuffer(&vbd);
+
+    mRectReady = true;
+}
