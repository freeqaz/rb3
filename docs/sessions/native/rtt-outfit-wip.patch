+// RTT (Layer A): lazily create/look-up a GPU render-target texture for a
+// kRenderedNoZ RndTex (OutfitConfig outfit-composite output). Mirrors DC3's
+// EnsureRenderTargetData (Tex_Wgpu.cpp:54-102). The texture gets
+// RenderAttachment|TextureBinding|CopyDst usage so it can both be a color
+// attachment (composite pass) AND a sampled diffuse (body draw). No depth
+// attachment — kRenderedNoZ is depth-disabled (the "NoZ"). Cleared once to
+// opaque black on creation so an un-composed target reads black not garbage.
+static RB3TexEntry* RB3EnsureRenderTarget(GpuDevice& gpu, RndTex* tex) {
+    if (!tex || !tex->IsRenderTarget() || !gpu.IsReady()) return nullptr;
+    // Render-target sizes come from the milo; guard zero with a 256 default
+    // (DC3 does the same — DTA set_bitmap/set_rendered may not run natively).
+    uint32_t w = tex->Width()  > 0 ? (uint32_t)tex->Width()  : 256;
+    uint32_t h = tex->Height() > 0 ? (uint32_t)tex->Height() : 256;
+    RB3TexEntry& e = sTexGpu[tex];
+    if (e.renderTarget && e.tex && e.view && e.rtW == w && e.rtH == h)
+        return &e;
+    wgpu::TextureDescriptor td{};
+    td.label = "RB3RenderTarget";
+    td.size = {w, h, 1};
+    // Match the BandRnd main-pass target format so the off-screen quad pipeline
+    // (which keys on mTargetFmt) is valid against this attachment.
+    td.format = gBandRnd.mTargetFmt;
+    td.usage = wgpu::TextureUsage::RenderAttachment |
+               wgpu::TextureUsage::TextureBinding |
+               wgpu::TextureUsage::CopyDst;
+    td.mipLevelCount = 1;
+    wgpu::Texture t = gpu.Device().CreateTexture(&td);
+    if (!t) return nullptr;
+
