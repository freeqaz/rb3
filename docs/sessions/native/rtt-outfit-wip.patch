+    // Coordinate space: OutfitConfig builds rects in TheRnd Width()×Height() pixel
+    // space (rect = full 0,0,W,H). Map [0,W]×[0,H] → NDC [-1,1].
+    float w = (float)Width(), h = (float)Height();
+    if (w <= 0 || h <= 0) return;
