+                mActiveTargetTex && mActiveTargetTex->Name() ? mActiveTargetTex->Name() : "?",
+                colorMod, fsEntry, dt && dt->Name() ? dt->Name() : "(none)",
+                c[0], c[1], c[2], c[3], (int)blend);
+    }
+}
