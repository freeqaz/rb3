+// Reconcile the active pass with the current camera's TargetTex (Layer B begin
+// trigger). OutfitConfig::Compose redirects rendering with sCam->SetTargetTex +
+// sCam->Select (not MakeDrawTarget), so we begin the off-screen pass the first
+// time a draw observes a non-null, renderable TargetTex. The matching teardown
+// is driven by RndTex::FinishDrawTarget (SetTargetTex(nullptr)); this also
+// reconciles defensively if the cam's target changed without that firing.
+bool BandRnd::SyncRenderTargetState() {
+    RndCam* cur = RndCam::sCurrent;
+    RndTex* want = cur ? cur->TargetTex() : nullptr;
+    // Only honor render targets we can actually back with a GPU attachment.
+    if (want && !want->IsRenderTarget()) want = nullptr;
+
+    if (want == mActiveTargetTex) return mActiveTargetTex != nullptr;
+
+    if (mActiveTargetTex && !want) {
+        // Target cleared without FinishDrawTarget — resume the main pass.
+        EndActivePass();
+        mActiveTargetTex = nullptr;
+        if (mFrameView) BeginMainPass(false);
+        return false;
+    }
+    // A (new) target is requested — switch the off-screen composite pass to it.
+    RB3SelectRenderTarget(want);
+    return mActiveTargetTex != nullptr;
+}
